# Privy — copy to .env.local (never commit secrets)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRIVY_SIGNER_QUORUM_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_SIGNER_QUORUM_ID=
PRIVY_WEBHOOK_SIGNING_SECRET=

# Local infra (docker compose up -d)
DATABASE_URL=postgresql://bloom:bloom@localhost:5433/bloom
# Redis optional — leave unset or set REDIS_DISABLED=1 if Redis isn't running locally
# REDIS_URL=redis://localhost:6380
# REDIS_DISABLED=1
REDIS_URL=redis://localhost:6380

# Always-on missions (recommended for autonomous DCA/arb/LP):
#   npm run worker:missions
# AgentQA smoke (no Privy): npm run qa:agent

# OpenUI Gateway / Thesys (server-only)
THESYS_API_KEY=

# Uniswap Trading API (server-only)
UNISWAP_API_KEY=

# CoinGecko — token logos (server-only). Demo key → plan=demo; paid key → plan=pro
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
# Optional: requests per minute (defaults: demo 50, pro 200 — under published caps)
# COINGECKO_MAX_RPM=50

# The Graph (server-only) — live V2/V3/V4 queries; not stored in Bloom DB
THE_GRAPH_API_KEY=
# Legacy override: Uniswap V3 Ethereum subgraph id
THE_GRAPH_UNISWAP_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Optional per-market overrides: UNISWAP_SUBGRAPH_{V2|V3|V4}_{chainId}
# Built-in: V2 eth/base; V3 eth/op/bsc/polygon/base/arb;
# V4 eth/op/bsc/unichain/polygon/base/arb/avax
UNISWAP_SUBGRAPH_V4_8453=Gqm2b5J85n1bhCyDMpGbtbVn4935EvvdyHdHrx3dibyj

# Substreams (The Graph Market JWT) — real-time stream; separate from subgraph API key
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=mainnet.eth.streamingfast.io:443
# Optional package override
# SUBSTREAMS_SPKG=https://spkg.io/streamingfast/ethereum-common-v0.3.3.spkg
# SUBSTREAMS_MODULE=all_events
# SUBSTREAMS_CHAIN_ID=1
